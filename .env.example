# 이 파일(.env.example)은 커밋됩니다. 실제 값은 .env.local 에 작성하세요(git 무시).
#   복사: cp .env.example .env.local
#
# ── Next.js 환경변수 파일 체계 ────────────────────────────────────────────
#   우선순위: .env.local > .env.production / .env.development > .env
#   - .env.local       로컬 개발용 오버라이드. git 무시. (지금 사용)
#   - .env.production   next build/start 시 로드.
#                       ※ Vercel 배포는 파일 대신 "Vercel 대시보드 → Settings →
#                          Environment Variables" 로 관리하는 것을 권장합니다.
#   - .env.example     이 템플릿(커밋)
#
#   NEXT_PUBLIC_ 접두사 = 브라우저(클라이언트)에 노출되는 공개 변수.
# ──────────────────────────────────────────────────────────────────────────

# 백엔드 API 서버 주소 (프론트는 항상 배포된 API 서버를 사용)
NEXT_PUBLIC_API_URL=https://xxx.com
