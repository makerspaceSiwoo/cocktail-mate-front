{
  "name": "cocktail-mate-front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/nextjs-vite": "^10.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.3.6",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "storybook": "^10.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "validate-branch-name": "^1.3.2",
    "vite": "^8.0.11"
  },
  "validate-branch-name": {
    "pattern": "^(main|develop|(feat|fix|hotfix|chore|docs|refactor|test)\\/[a-z0-9._-]+)$",
    "errorMsg": "❌ 잘못된 브랜치명입니다. 허용 패턴: main | develop | (feat|fix|hotfix|chore|docs|refactor|test)/소문자-슬러그"
  }
}
